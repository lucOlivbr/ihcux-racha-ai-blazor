@using ihcux_racha_ai_blazor.Models

<div class="card mb-3 p-3">
    <small class="text-muted">@Grupo.Categoria</small>
    <div class="d-flex justify-content-between align-items-center">
        <strong>@Grupo.Nome</strong>
        <div class="text-end">
            <small class="@(Grupo.NoVermelho ? "text-danger" : "text-success")">
                @(Grupo.NoVermelho ? "Você deve" : "Você recebe")
            </small>
            <br />
            <strong class="@(Grupo.NoVermelho ? "text-danger" : "text-success")">
                @Grupo.ValorPendente.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
            </strong>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Grupo Grupo { get; set; } = new();
}